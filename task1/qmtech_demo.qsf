set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL080YU484C8G
set_global_assignment -name TOP_LEVEL_ENTITY qmtech_demo_top
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_FILE conveyor_sorter.vhd
set_global_assignment -name VHDL_FILE flow_tester.vhd
set_global_assignment -name VHDL_FILE qmtech_demo_top.vhd
set_global_assignment -name SDC_FILE qmtech_demo.sdc
set_location_assignment PIN_G1 -to clk50_i
set_location_assignment PIN_P4 -to nRst_btn_i
set_location_assignment PIN_V10 -to conveyorLed_n_o
set_location_assignment PIN_U9 -to rejectLed_n_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk50_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to nRst_btn_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to conveyorLed_n_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rejectLed_n_o

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Standard Edition"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
# On-board LEDs have 1 kOhm series resistors (QMTECH V03 schematic).
set_instance_assignment -name CURRENT_STRENGTH_NEW "4MA" -to conveyorLed_n_o
set_instance_assignment -name CURRENT_STRENGTH_NEW "4MA" -to rejectLed_n_o
