 [3],[1],[0],[50],[30],[Рост веса],
 [4],[1],[1],[80],[60],[Центр обнаружен],
 [5],[1],[1],[100],[80],[Отсчёт до спада],
 [6],[1],[1],[98],[78],[Первый спад],
