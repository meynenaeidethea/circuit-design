process(clk, reset)
begin

    if reset = '1' then
        state <= WAIT_STATE;
        counter <= 0;

    elsif rising_edge(clk) then

        case state is

            when WAIT_STATE =>
                counter <= 0;

                if item_present = '1' then
                    state <= STABILIZE_STATE;
                end if;

            when STABILIZE_STATE =>
                if counter = STABILIZE_TICKS - 1 then
                    counter <= 0;
                    state <= CHECK_STATE;
                else
                    counter <= counter + 1;
                end if;

            when CHECK_STATE =>
                if unsigned(weight) >= M_MIN and unsigned(weight) <= M_MAX then
                    state <= RELEASE_STATE;
                else
                    state <= REJECT_STATE;
                end if;

            when REJECT_STATE =>
                if counter = REJECT_TICKS - 1 then
                    counter <= 0;
                    state <= RELEASE_STATE;
                else
                    counter <= counter + 1;
                end if;

            when RELEASE_STATE =>
                counter <= 0;

                if item_present = '0' then
                    state <= WAIT_STATE;
                end if;

        end case;

    end if;

end process;
